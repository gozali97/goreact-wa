# ─── Server ───────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0

# ─── Dashboard Basic Auth ─────────────────────────────────
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=secret123

# ─── PostgreSQL ───────────────────────────────────────────
# Code defaults (if unset): user/pass/db all = "waproxy", host=localhost, port=5432.
# Example below targets a typical local Postgres (e.g. Laragon on port 5434).
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=
DB_NAME=waproxy
DB_SSLMODE=disable

# ─── Storage ──────────────────────────────────────────────
STORAGE_PATH=./storage

# ─── Logs ─────────────────────────────────────────────────
# Directory for daily JSON-lines log files (wa-proxy-YYYY-MM-DD.log)
LOG_PATH=./logs

# ─── WhatsApp / Broadcast ─────────────────────────────────
# Random delay range (milliseconds) between broadcast messages
BROADCAST_MIN_DELAY_MS=3000
BROADCAST_MAX_DELAY_MS=8000
BROADCAST_MAX_RETRY=2

# ─── External Integration API (WAHA-style) ───────────────
# The API key is stored entirely in the DATABASE and managed from the dashboard
# (Device page: it's generated automatically when WhatsApp connects, can be
# copied / regenerated, and is deleted on logout). There is no API_KEY env var.

# ─── Outbound Webhooks ────────────────────────────────────
# If WEBHOOK_URL is set, incoming messages, delivery receipts and session
# status changes are POSTed to it as JSON. WEBHOOK_SECRET (optional) signs the
# body with HMAC-SHA256 in the X-Webhook-Signature header.
# WEBHOOK_EVENTS is a comma list (message,message.ack,session.status); empty=all
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_MAX_RETRY=3
WEBHOOK_EVENTS=

# ─── Anti-blocking ────────────────────────────────────────
# When true, sends mark-seen + typing presence with a short random delay before
# delivering a message (mimics human behavior, reduces ban risk).
HUMANIZE_SEND=false

# ─── Rate limiting (anti-ban) ─────────────────────────────
# Enforced on the messaging/reply API. Broadcast has its own pacing and bypasses
# this limiter. RATE_MIN_INTERVAL_SEC is the minimum seconds between messages to
# the SAME number (default 30). RATE_GLOBAL_INTERVAL_SEC paces ALL sends (0=off).
RATE_LIMIT_ENABLED=true
RATE_MIN_INTERVAL_SEC=30
RATE_GLOBAL_INTERVAL_SEC=0

# ─── Media retention (disk guard) ─────────────────────────
# Auto-delete stored media (images/docs/media) older than this many days.
# Prevents unbounded disk growth. Set to 0 to disable auto-cleanup.
MEDIA_RETENTION_DAYS=14
